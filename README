mock --root rhel-7-s390x --rebuild libX11-1.6.7-2.el7.src.rpm
mock --root rhel-7-s390x --rebuild libXau-1.0.8-2.1.el7.src.rpm
mock --root rhel-7-s390x --rebuild libXdmcp-1.1.2-6.el7.src.rpm
